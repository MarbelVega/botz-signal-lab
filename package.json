{
  "name": "botz-signal-lab",
  "private": true,
  "version": "0.1.0",
  "description": "PoC educativo: dashboard de señales (tuplas), confluencia de 5 indicadores sobre 3 velas (Ley 1 / Ley 2) y simulador de ciclos. Sin ejecución financiera real.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lightweight-charts": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
